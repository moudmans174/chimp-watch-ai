# --- required secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
POSTGRES_PASSWORD=change-me
CW_SECRET_KEY=change-me-in-production-please-use-64-random-bytes

# --- application ---
# Port the web app is served on (http://localhost:<port>)
CW_WEB_PORT=8090
CW_ENVIRONMENT=production
CW_CORS_ORIGINS=["https://chimpwatch.example.org"]
CW_ACCESS_TOKEN_MINUTES=480
CW_LOCATION_GENERALISATION_DEG=0.1
CW_WORKER_INTERVAL_MINUTES=360

# Load synthetic Sierra Leone demo data on first start (never in a real deployment)
CW_SEED_DEMO=false

# Camera-trap classifier: manual (expert review only) or http (external inference endpoint)
CW_CLASSIFIER_BACKEND=manual
# CW_CLASSIFIER_URL=https://inference.internal/detect

# --- social sign-in (optional; each provider is enabled once its values are set) ---
# The address people use to reach the site. Callback URLs are {CW_PUBLIC_URL}/api/auth/oauth/<provider>/callback
CW_PUBLIC_URL=http://localhost:8090
# Google: https://console.cloud.google.com/apis/credentials  (OAuth client ID, type "Web application")
CW_GOOGLE_CLIENT_ID=
CW_GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers  (New OAuth App)
CW_GITHUB_CLIENT_ID=
CW_GITHUB_CLIENT_SECRET=
# Apple: https://developer.apple.com/account/resources  (Services ID + Sign in with Apple key; needs a public HTTPS domain)
CW_APPLE_CLIENT_ID=
CW_APPLE_TEAM_ID=
CW_APPLE_KEY_ID=
# Paste the .p8 key on one line, replacing line breaks with \n
CW_APPLE_PRIVATE_KEY=
